[MAIN]
py-version = 3.10
fail-under = 9.0
# C extensions whose members pylint can not infer
extension-pkg-allow-list = pygame,cv2,gphoto2

[TYPECHECK]
# OpenCV exposes its API from a binary module pylint can not inspect
generated-members = cv2.*

[FORMAT]
max-line-length = 160

[MESSAGES CONTROL]
# Docstrings are not required. Unlike master, the style messages are kept
# enabled: the 3.x coding rules ask for f-strings, so the remaining
# "{}".format() calls are worth reporting.
disable =
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring
